# Wymlink web app — copy to .env.local (local) or set in Vercel. Never commit real values.

# Backend API, used only by the Next.js server (browsers never call it directly).
API_BASE_URL=http://localhost:4000/api/v1
# Fallback for older code paths; keep equal to API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Same value as the backend's BFF_SHARED_SECRET, so the backend can trust the
# customer IP this server reports (rate limits, audit logs). Server-only secret.
BFF_SHARED_SECRET=

# Public site URL (canonical links, emails).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Sanity (blog). Project id and dataset are public values.
NEXT_PUBLIC_SANITY_PROJECT_ID=vstxv62p
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Lets the admin console write blog posts (sanity.io/manage -> API -> Tokens, Editor rights).
# Server-only secret.
SANITY_API_WRITE_TOKEN=
